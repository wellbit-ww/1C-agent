# Скопируйте в .env и при необходимости измените значения.

# --- Ollama / LLM ---
# Адрес Ollama-сервера
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Основная модель (ответы-рассуждения)
EXCEL_AGENT_MODEL=qwen3:8b
# Модель роутера чата (классификация запросов); можно поставить более лёгкую, напр. qwen3:4b
EXCEL_AGENT_ROUTER_MODEL=qwen3:8b
# Таймаут health-check Ollama при старте backend, секунды
EXCEL_AGENT_OLLAMA_HC_TIMEOUT=3

# --- Загрузка файлов ---
# Максимальный размер загружаемого Excel-файла, МБ
EXCEL_AGENT_MAX_UPLOAD_MB=50
# Каталог загрузок (по умолчанию backend/uploads)
# EXCEL_AGENT_UPLOAD_DIR=backend/uploads

# --- Сеть ---
# Разрешённые CORS-источники, через запятую
EXCEL_AGENT_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Адрес backend для Streamlit UI
EXCEL_AGENT_API_URL=http://127.0.0.1:8000
# Таймаут запросов UI -> backend, секунды
EXCEL_AGENT_REQUEST_TIMEOUT=300
