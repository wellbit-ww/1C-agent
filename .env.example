# Скопируйте в .env и при необходимости измените значения.

# --- Ollama / LLM ---
# Адрес Ollama-сервера
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Основная модель (ответы-рассуждения)
EXCEL_AGENT_MODEL=qwen3:8b
# Модель роутера чата (классификация запросов); можно поставить более лёгкую, напр. qwen3:4b
EXCEL_AGENT_ROUTER_MODEL=qwen3:8b
# Таймаут health-check Ollama при старте backend, секунды
EXCEL_AGENT_OLLAMA_HC_TIMEOUT=3
# Сколько ждать TCP-подключение к Ollama, секунды
EXCEL_AGENT_OLLAMA_CONNECT_TIMEOUT=5
# Сколько ждать ответ модели (генерацию), секунды; иначе запрос висит бесконечно
EXCEL_AGENT_OLLAMA_TIMEOUT=90
# Потолок токенов для обычных ответов ask_llm (отчёт/классификация задают свой)
EXCEL_AGENT_LLM_NUM_PREDICT=800

# --- Загрузка файлов ---
# Максимальный размер загружаемого Excel/CSV-файла, МБ
EXCEL_AGENT_MAX_UPLOAD_MB=50
# Каталог загрузок (по умолчанию backend/uploads)
# EXCEL_AGENT_UPLOAD_DIR=backend/uploads

# --- Персистентность ---
# Каталог данных: SQLite-реестр и parquet-кэш (по умолчанию backend/data)
# EXCEL_AGENT_DATA_DIR=backend/data
# EXCEL_AGENT_DB=backend/data/agent.db
# EXCEL_AGENT_CACHE_DIR=backend/data/cache
# Сколько часов parquet-кэш считается свежим
EXCEL_AGENT_CACHE_TTL_HOURS=72
# Через сколько часов удалять выгрузки с диска и из БД (0 = не чистить по возрасту)
EXCEL_AGENT_FILE_TTL_HOURS=168
# Таймаут SQLite при параллельных запросах, секунды (WAL включается сам)
EXCEL_AGENT_SQLITE_TIMEOUT=30
# Сколько сообщений чата хранить/учитывать как контекст
EXCEL_AGENT_CHAT_HISTORY_LIMIT=20
EXCEL_AGENT_CHAT_HISTORY_CONTEXT=6
# Лимит длины вопроса / NL-запроса (символы)
EXCEL_AGENT_MAX_QUESTION_CHARS=4000
# Лимит длины текста отчёта в PDF (символы)
EXCEL_AGENT_MAX_NARRATIVE_CHARS=20000

# --- Сеть ---
# Разрешённые CORS-источники, через запятую
EXCEL_AGENT_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Адрес backend для Streamlit UI
EXCEL_AGENT_API_URL=http://127.0.0.1:8000
# Таймаут запросов UI -> backend, секунды
EXCEL_AGENT_REQUEST_TIMEOUT=300
# Если задать — backend требует заголовок X-API-Token (тот же ключ в UI).
# Без токена API открыт для всех, кто достучался до порта. start.bat слушает 127.0.0.1.
# EXCEL_AGENT_API_TOKEN=
